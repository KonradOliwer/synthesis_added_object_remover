<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AddedObjectRemover</RootNamespace>
    <Description>The Synthesis entry. It reads the settings, builds the plugin and mesh readers and the report output, calls the runner, and prints the log. The only project that uses the console and the Synthesis packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.6" />
    <!-- Synthesis reads the Mutagen version only from this project's own references, so it must match the version the tools use. -->
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tools\FileSystemAccess\FileSystemAccess.csproj" />
    <ProjectReference Include="..\Tools\CsvFileWriting\CsvFileWriting.csproj" />
    <ProjectReference Include="..\Tools\PluginRecordReadingAndWriting\PluginRecordReadingAndWriting.csproj" />
    <ProjectReference Include="..\Tools\MeshFileReading\MeshFileReading.csproj" />
    <ProjectReference Include="..\Tools\UnexpectedFailureHandling\UnexpectedFailureHandling.csproj" />
    <ProjectReference Include="..\Caches\BaseObjectShapeAndKind.Contracts\BaseObjectShapeAndKind.Contracts.csproj" />
    <ProjectReference Include="..\Steps\SelectObjectsThatCanCauseRemovals.Contracts\SelectObjectsThatCanCauseRemovals.Contracts.csproj" />
    <ProjectReference Include="..\Steps\RemoveObjectsOnChangedTerrain.Contracts\RemoveObjectsOnChangedTerrain.Contracts.csproj" />
    <ProjectReference Include="..\Steps\RemoveTooCloseObjects.Contracts\RemoveTooCloseObjects.Contracts.csproj" />
    <ProjectReference Include="..\Steps\FitClashingObjects.Contracts\FitClashingObjects.Contracts.csproj" />
    <ProjectReference Include="..\Steps\RemoveObjectsRestingOnRemovedOnes.Contracts\RemoveObjectsRestingOnRemovedOnes.Contracts.csproj" />
    <ProjectReference Include="..\Steps\RemoveInvisibleObjectsLeftBehind.Contracts\RemoveInvisibleObjectsLeftBehind.Contracts.csproj" />
    <ProjectReference Include="..\Steps\BuildLogAndReports.Contracts\BuildLogAndReports.Contracts.csproj" />
    <ProjectReference Include="..\Run\RunAllSteps.Contracts\RunAllSteps.Contracts.csproj" />
    <ProjectReference Include="..\Run\RunSettingsValidation\RunSettingsValidation.csproj" />
    <ProjectReference Include="..\Run\RunSettingsValidation.Contracts\RunSettingsValidation.Contracts.csproj" />
    <ProjectReference Include="..\Run\RunSettingsReading\RunSettingsReading.csproj" />
    <ProjectReference Include="..\Run\RunAllSteps\RunAllSteps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AddedObjectRemover.Tests" />
  </ItemGroup>
</Project>
