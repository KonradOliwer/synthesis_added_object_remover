<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AddedObjectRemover</RootNamespace>
    <Description>What the entry gives a run and what a run returns: the load order's facts, the factories of the plugin and mesh readers, the log and report outputs, the restored parts file, and how the run ended. It references RunSettingsValidation.Contracts, PluginRecordFacts, MeshFileFacts, CsvFileWriting, ObjectsRestingOnRemovedOnes.Contracts, CollectPlacedObjects.Contracts (the restored parts) and the Report contracts, and holds no packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RunSettingsValidation.Contracts\RunSettingsValidation.Contracts.csproj" />
    <ProjectReference Include="..\..\Tools\PluginRecordFacts\PluginRecordFacts.csproj" />
    <ProjectReference Include="..\..\Tools\MeshFileFacts\MeshFileFacts.csproj" />
    <ProjectReference Include="..\..\Tools\CsvFileWriting\CsvFileWriting.csproj" />
    <ProjectReference Include="..\..\Rules\ObjectsRestingOnRemovedOnes.Contracts\ObjectsRestingOnRemovedOnes.Contracts.csproj" />
    <ProjectReference Include="..\..\Steps\BuildLogAndReports.Contracts\BuildLogAndReports.Contracts.csproj" />
    <ProjectReference Include="..\..\Steps\CollectPlacedObjects.Contracts\CollectPlacedObjects.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AddedObjectRemover.Tests" />
  </ItemGroup>
</Project>
