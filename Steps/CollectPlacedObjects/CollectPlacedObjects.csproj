<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AddedObjectRemover</RootNamespace>
    <Description>Gathers from the load order the target's placed objects, the other mods' placed objects in the same spaces and the links to them, leaving out removed ones (deleted, or disabled for good), and judging the target's objects the patch holds where the patch put them. Another mod's object can cause removals when the accepted-value rule finds it changed. It references its contracts, IdentifyTheMods.Contracts, WriteThePatch.Contracts, Ids and the package-free tools it uses, and holds no packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CollectPlacedObjects.Contracts\CollectPlacedObjects.Contracts.csproj" />
    <ProjectReference Include="..\IdentifyTheMods.Contracts\IdentifyTheMods.Contracts.csproj" />
    <ProjectReference Include="..\WriteThePatch.Contracts\WriteThePatch.Contracts.csproj" />
    <ProjectReference Include="..\..\Ids\AddedObjectRemover.Ids.csproj" />
    <ProjectReference Include="..\..\Tools\PluginRecordFacts\PluginRecordFacts.csproj" />
    <ProjectReference Include="..\..\Tools\BoxAndTransformMath\BoxAndTransformMath.csproj" />
    <ProjectReference Include="..\..\Tools\BoxSpatialIndex\BoxSpatialIndex.csproj" />
    <ProjectReference Include="..\..\Tools\OrderIndependentParallelWork\OrderIndependentParallelWork.csproj" />
    <ProjectReference Include="..\..\Tools\DenseIdTables\DenseIdTables.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AddedObjectRemover.Tests" />
  </ItemGroup>
</Project>
