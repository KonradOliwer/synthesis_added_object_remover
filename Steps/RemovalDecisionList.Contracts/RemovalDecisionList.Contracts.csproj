<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AddedObjectRemover</RootNamespace>
    <Description>The decisions about which target objects are removed, kept or kept shrunk or turned where they stand, round by round, the proposals steps make, and the rules steps share to judge an object shrunk or turned and to find the objects others rest on. It references Ids, BoxAndTransformMath (for the placement), CompassSectorAreas (for the fate of a neighbour),CollectPlacedObjects.Contracts (for the target object a rule checks), FindTargetObjectsToKeep.Contracts and UnexpectedFailureHandling (for the failures of a pass) and holds no packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Ids\AddedObjectRemover.Ids.csproj" />
    <ProjectReference Include="..\..\Tools\BoxAndTransformMath\BoxAndTransformMath.csproj" />
    <ProjectReference Include="..\..\Tools\CompassSectorAreas\CompassSectorAreas.csproj" />
    <ProjectReference Include="..\CollectPlacedObjects.Contracts\CollectPlacedObjects.Contracts.csproj" />
    <ProjectReference Include="..\FindTargetObjectsToKeep.Contracts\FindTargetObjectsToKeep.Contracts.csproj" />
    <ProjectReference Include="..\..\Tools\UnexpectedFailureHandling\UnexpectedFailureHandling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AddedObjectRemover.Tests" />
  </ItemGroup>
</Project>
