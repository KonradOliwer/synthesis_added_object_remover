<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AddedObjectRemover</RootNamespace>
    <Description>The step's passes over the target objects found too close to another mod's object, and the other-mod objects it leaves out. It references Ids, BaseObjectShapeAndKind.Contracts (for the ways of being invisible), CollectPlacedObjects.Contracts, RemovalDecisionList.Contracts, ObjectsThatCanCauseRemovals.Contracts and TooCloseToOtherModsObjects.Contracts (the rule's findings, settings and NPC handling), OrderIndependentParallelWork and UserDataFailureHandling, and holds no packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Ids\AddedObjectRemover.Ids.csproj" />
    <ProjectReference Include="..\..\Caches\BaseObjectShapeAndKind.Contracts\BaseObjectShapeAndKind.Contracts.csproj" />
    <ProjectReference Include="..\CollectPlacedObjects.Contracts\CollectPlacedObjects.Contracts.csproj" />
    <ProjectReference Include="..\..\Rules\ObjectsThatCanCauseRemovals.Contracts\ObjectsThatCanCauseRemovals.Contracts.csproj" />
    <ProjectReference Include="..\..\Rules\TooCloseToOtherModsObjects.Contracts\TooCloseToOtherModsObjects.Contracts.csproj" />
    <ProjectReference Include="..\RemovalDecisionList.Contracts\RemovalDecisionList.Contracts.csproj" />
    <ProjectReference Include="..\..\Tools\OrderIndependentParallelWork\OrderIndependentParallelWork.csproj" />
    <ProjectReference Include="..\..\Tools\UserDataFailureHandling\UserDataFailureHandling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AddedObjectRemover.Tests" />
  </ItemGroup>
</Project>
